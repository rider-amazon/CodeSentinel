{
  "description": "允许改动的文件/目录范围声明。执行阶段的实际改动若超出 allow 列表，harness execute 会标记为越界（in_plan=false）。",
  "allow": [
    "server/app.py",
    "server/problems.py",
    "server/store.py",
    "server/defense/perturb.py",
    "server/defense/variant.py",
    "server/judge/engine.py",
    "web/problem.html",
    "web/index.html",
    "web/submissions.html",
    "web/experiment.html",
    "web/static/common.js",
    "web/static/style.css",
    "experiment/run_experiment.py",
    "experiment/analyze.py",
    "start.py",
    "requirements.txt",
    ".gitignore",
    "harness/README.md",
    "harness/PRINCIPLES.md",
    "harness/INDEX.md",
    "harness/execute/rules.md",
    "harness/execute/scope.md",
    "harness/verify/checklist.md",
    "harness/rules/scope.json",
    "harness/schemas/*.json",
    "harness/templates/*.json",
    "harness/templates/*.yaml",
    "harness/scripts/*.py",
    "harness/tests/*.py",
    "harness/execute/_template.md",
    "harness/verify/_template.md",
    "*.md",
    "审查纪要",
    "差距清单",
    "开发日志",
    "当日报告*",
    "技术选型比选表",
    "接口书面约定",
    "数据模型",
    "演示说明"
  ],
  "deny": [
    ".env",
    "experiment/config.json",
    "data/",
    "report/"
  ],
  "note": "任何对 deny 列表或 allow 列表外文件的改动，都必须在计划阶段显式说明并经人工确认。"
}
